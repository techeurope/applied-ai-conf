# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# service worker (built by @serwist/next from app/sw.ts on each build)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.DS_Store

# WSL Zone.Identifier files
*:Zone.Identifier

# claude code
.claude/

# .beads/ is intentionally tracked for multi-agent task sync
.env*.local

# print pipeline artifacts (generated by /print + scripts/stitch-print.mjs)
/public/print/_tiles/
/public/print/*.png

# admin grant script — uncommitted on purpose
/scripts/admin-grant.mjs

# Local design experiments — Tim's WIP, never push to prod
/app/app/preview/
